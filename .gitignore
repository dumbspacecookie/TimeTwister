# Xcode
build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.moved-aside

# Swift Package Manager
.build/
Packages/
Package.resolved

# CocoaPods / Carthage (unused but future-proof)
Pods/
Carthage/Build/

# Android / Gradle
.gradle/
# Kotlin compiler daemon session locks. Untracked but not ignored is a trap:
# one `git add -A` and they are in the tree.
.kotlin/
android/**/build/
android/local.properties
desktop/local.properties
android/captures/
android/.cxx/
android/app/release/
*.iml

# Android signing — keep keystores + their creds out of the repo.
# CI signs via TIMETWISTER_KEYSTORE_* env vars instead.
android/app/keystore.properties
*.jks
*.keystore
# android-release.yml decodes the keystore secret into this directory *inside the
# workspace*, so it has to be ignored or a local reproduction of the workflow
# leaves a committable private key behind.
.keystore/

# Apple signing material. A distribution cert or App Store Connect key exported
# during a Mac session lands in the working tree as one of these — never commit them.
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
ExportOptions.plist

# Local secrets / env files
.env
.env.*

# macOS
.DS_Store

# IDE
.vscode/
.idea/
