<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Optional permission. Only used by the "Suggest zones from contacts" button
        in the settings screen — we read the country code off contact phone numbers
        to propose target zones. Phone numbers themselves never leave the device,
        and the app still works fully if the user denies this.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        allowBackup stays on — the only thing this app persists is the user's
        chosen target zones, and re-picking them is the only setup it has. It is
        now paired with explicit rules so that is a decision rather than a
        default: without them, "true" means "back up whatever is in the data
        directory, now and in every future version".

        Both files are declared because minSdk is 26: fullBackupContent covers
        API 23-30, dataExtractionRules covers 31+.
    -->
    <!--
        adjustResize on MainActivity is load-bearing, not tidiness: it is what lets
        WindowInsets.ime report a real height, which is what makes imePadding() in the zone
        picker work. Without it the picker draws under the keyboard again.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeTwister">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ACTION_PROCESS_TEXT — the primary entry point. When the user selects text in
            any app and picks "TimeTwister" from the selection toolbar, Android launches
            this activity with the selected text as an extra. We transform and return it.

            Translucent.NoTitleBar, not NoDisplay: we still draw no content, but NoDisplay
            forbids the window from ever being shown, which also suppresses Toasts posted
            before finish(). That turned "no time in your selection" and "this message is
            read-only" into identical silent no-ops — indistinguishable from a broken app.
            Translucent keeps us invisible while letting us speak.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:label="@string/process_text_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
